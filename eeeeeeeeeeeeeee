local Utility = {}; do
    function Utility.AddConnection(Signal, Function)
        local Conn = Signal:Connect(function(...)
            local Args = {...}
            local ok, msg = pcall(function() coroutine_wrap(Function)(table_unpack(Args)) end)
            if not ok and not ESPErrors[msg] then
                warn(string_format("[ERROR] | An error has occured:\n%s", msg))
                ESPErrors[msg] = msg
                if ConnectionsTable[Conn] then ConnectionsTable[Conn] = nil end
                return Conn and Conn:Disconnect()
            end
        end)
        if Conn and ConnectionsTable then table_insert(ConnectionsTable, Conn) end
        return Conn
    end

    function Utility.CreateObject(Type, Properties)
        local Obj = Instance_new(Type)
        for Index, Value in Properties do Obj[Index] = Value end
        table_insert(ObjectsTable, Obj)
        return Obj
    end

    function Utility.CalculateBox(Settings, Target, RootPart, Parts)
        local MinX, MinY, MaxX, MaxY = 9000, 9000, -9000, -9000
        local BW, BH = 0, 0
        local Pos, OnScreen = WorldToViewportPoint(Camera, RootPart.Position)

        if Settings.BoundingBox.DynamicBox then
            for _, Part in Parts do
                if IsA(Part, "BasePart") and Part.Name ~= "HumanoidRootPart" and Part.Transparency ~= 1 then
                    local CF, S = Part.CFrame, Part.Size
                    local Corners = {
                        CF * Vector3_new( S.X/2,  S.Y/2,  S.Z/2), CF * Vector3_new(-S.X/2,  S.Y/2,  S.Z/2),
                        CF * Vector3_new( S.X/2, -S.Y/2,  S.Z/2), CF * Vector3_new(-S.X/2, -S.Y/2,  S.Z/2),
                        CF * Vector3_new( S.X/2,  S.Y/2, -S.Z/2), CF * Vector3_new(-S.X/2,  S.Y/2, -S.Z/2),
                        CF * Vector3_new( S.X/2, -S.Y/2, -S.Z/2), CF * Vector3_new(-S.X/2, -S.Y/2, -S.Z/2),
                    }
                    for _, C in Corners do
                        local SP = WorldToViewportPoint(Camera, C)
                        MinX, MinY = math_min(MinX, SP.X), math_min(MinY, SP.Y)
                        MaxX, MaxY = math_max(MaxX, SP.X), math_max(MaxY, SP.Y)
                    end
                end
            end
            BW, BH = MaxX - MinX, MaxY - MinY
        else
            local Scale = (RootPart.Size.Y * Camera.ViewportSize.Y) / (Pos.Z * 2)
            BW, BH = 3 * Scale, 4.5 * Scale
            MinX, MinY = Pos.X - BW/2, Pos.Y - BH/2
        end
        return BW, BH, MinX, MinY, OnScreen
    end

    function Utility.GetFontType(Settings, Text)
        local FT = string_lower(Settings.FontType)
        if FT == "uppercase" then return string_upper(Text) end
        if FT == "lowercase" then return string_lower(Text) end
        return Text
    end
end

