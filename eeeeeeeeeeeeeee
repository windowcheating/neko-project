            ESP.Targets[Type][Target] = TargetInfo
        end

        local FadeInfo = TweenInfo_new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local function SetTargetFade(TargetInfo, Visible)
            if not TargetInfo then return end
            if TargetInfo.FadeTween then TargetInfo.FadeTween:Cancel() end
            local target = Visible and 0 or 1
            local boxGroup = TargetInfo.Objects.BoxGroup
            if boxGroup and boxGroup:IsA("CanvasGroup") then
                local tween = TweenService:Create(boxGroup, FadeInfo, {GroupTransparency = target})
                TargetInfo.FadeTween = tween
                tween:Play()
            end
        end

        function TargetInfo.Update()
            if not ESPSettings.Players.Enabled and Type == "Players" then
                if Objects["TargetHolder"] then Objects["TargetHolder"].Visible = false end
                if TargetInfo.ChamsHighlight then TargetInfo.ChamsHighlight.Enabled = false end
                return
            end

            local now = os_clock()
            if (now - TargetInfo.LastTick) < (1 / Settings.RefreshRate) then return end

            if TargetInfo.Dirty or #CO.Children == 0 then
                CO.Children    = PlayerHelper.GetChildren(CO.Character)
                CO.Descendants = PlayerHelper.GetDescendants(CO.Character)
                TargetInfo.Dirty = false
            end

            TargetInfo.LastTick = now
            Objects["TargetHolder"].Visible = false
            TargetInfo.ChamsHighlight.Enabled = false

            if (not Settings.LocalPlayer) and Target == Client then return end
            if not CO.Character then return end

            if IsPlayer then
                if not CO.HumanoidRootPart then
                    CO.HumanoidRootPart = CO.Character and FindFirstChild(CO.Character, "HumanoidRootPart")
                    return
                end
                if not CO.Humanoid then
                    CO.Humanoid = CO.Character and FindFirstChildWhichIsA(CO.Character, "Humanoid")
                    return
                end
            else
                if not CO.HumanoidRootPart then
                    CO.HumanoidRootPart = (IsA(Target, "BasePart") and Target) or (CO.Character and CO.Character.PrimaryPart)
                    return
                end
            end

            local Distance = (Camera.CFrame.Position - CO.HumanoidRootPart.Position).Magnitude
            if Distance > Settings.MaxDistance then return end

            local BodyParts = Settings.BoundingBox.IncludeAccessories and CO.Descendants or CO.Children
            local BW, BH, BX, BY, OnScreen = Utility.CalculateBox(Settings, Target, CO.HumanoidRootPart, (if IsBasePart then {Target} else BodyParts))

            if not OnScreen then
                Objects["TargetHolder"].Visible = false
                SetTargetFade(TargetInfo, false)
                return
            end

            -- ── Chams Sync (Highlight Engine) ──
            if Settings.Chams.Enabled then
                TargetInfo.ChamsHighlight.Enabled = true
                TargetInfo.ChamsHighlight.FillColor = Settings.Chams.Fill[1]
                TargetInfo.ChamsHighlight.FillTransparency = Settings.Chams.Fill[2]
                TargetInfo.ChamsHighlight.OutlineColor = Settings.Chams.Outline[1]
                TargetInfo.ChamsHighlight.OutlineTransparency = Settings.Chams.Outline[2]
            else
                TargetInfo.ChamsHighlight.Enabled = false
            end

            local holder = Objects["TargetHolder"]
            holder.Visible = true
            holder.Position = UDim2_fromOffset(math_floor(BX), math_floor(BY))
            holder.Size     = UDim2_fromOffset(math_floor(BW), math_floor(BH))

            -- ── Box + Glow ──
            local BoxGroup = Objects["BoxGroup"]
            local BoxGlow, BoxOutline, BoxInline, BoxFill = Objects["BoxGlow"], Objects["BoxOutline"], Objects["BoxInline"], Objects["BoxFill"]
            do
                local BB = Settings.BoundingBox
                if BB.Enabled then
                    BoxGroup.Visible = true

                    local Glow = BB.Glow
                    if Glow.Enabled then
                        BoxGlow.Visible = true
                        BoxGlow.ImageTransparency = 0.65 - (Glow.Transparency[1] or 0) * 0.5
                        Objects["BoxGlowGradient"].Rotation = Glow.Rotation
                        Objects["BoxGlowGradient"].Color = ColorSequence_new{ColorSequenceKeypoint_new(0, Glow.Color[1]), ColorSequenceKeypoint_new(1, Glow.Color[2])}
                        Objects["BoxGlowGradient"].Transparency = NumberSequence_new{NumberSequenceKeypoint_new(0, Glow.Transparency[1]), NumberSequenceKeypoint_new(1, Glow.Transparency[2])}
                    else
                        BoxGlow.Visible = false
                    end

                    if BB.Type == "2D" then
                        BoxOutline.Parent.Visible = true
                        BoxInline.Parent.Visible  = true
                        BoxInline.BorderOffset = UDim_new(0, 1)
                        Objects["BoxInlineGradient"].Color        = ColorSequence_new{ColorSequenceKeypoint_new(0, BB.Color[1]), ColorSequenceKeypoint_new(1, BB.Color[2])}
                        Objects["BoxInlineGradient"].Transparency = NumberSequence_new{NumberSequenceKeypoint_new(0, BB.Transparency[1]), NumberSequenceKeypoint_new(1, BB.Transparency[2])}
                        Objects["BoxInlineGradient"].Rotation     = BB.Rotation
                        Objects["BoxOutlineGradient"].Transparency = NumberSequence_new{NumberSequenceKeypoint_new(0, BB.Transparency[1]), NumberSequenceKeypoint_new(1, BB.Transparency[2])}
                        Objects["BoxOutlineGradient"].Rotation     = BB.Rotation
                        BoxFill.Visible = BB.Fill.Enabled
                        Objects["BoxFillGradient"].Rotation     = BB.Fill.Rotation
                        Objects["BoxFillGradient"].Color        = ColorSequence_new{ColorSequenceKeypoint_new(0, BB.Fill.Color[1]), ColorSequenceKeypoint_new(1, BB.Fill.Color[2])}
                        Objects["BoxFillGradient"].Transparency = NumberSequence_new{NumberSequenceKeypoint_new(0, BB.Fill.Transparency[1]), NumberSequenceKeypoint_new(1, BB.Fill.Transparency[2])}
                    end
                else
                    BoxGroup.Visible = false
                end
            end

            -- ── Bars ──
            for BarName, Bar in Settings.Bars do
                local BarFrame, BarOutline = Objects[BarName], Objects[BarName .. "Outline"]
                local NewParent = Objects[Bar.Position .. "BarHolder"]
                if Bar.Enabled and IsPlayer then
                    local val = Bar.Type(Target, CO)
                    NewParent.Visible = true
                    local sizes   = {Top = UDim2_new(val,0,0,1), Bottom = UDim2_new(val,0,0,1), Left = UDim2_new(0,1,val,0), Right = UDim2_new(0,1,val,0)}
                    local outl    = {Top = UDim2_new(1,0,0,1), Bottom = UDim2_new(1,0,0,1), Left = UDim2_new(0,1,1,0), Right = UDim2_new(0,1,1,0)}
                    local anchors = {Top = Vector2_new(0,0), Bottom = Vector2_new(0,0), Left = Vector2_new(0,1), Right = Vector2_new(0,1)}
                    local grads   = {Top = {-180, Vector2_new(1-val,0)}, Bottom = {-180, Vector2_new(1-val,0)}, Left = {90, Vector2_new(0,val-1)}, Right = {90, Vector2_new(0,val-1)}}

                    BarFrame.AnchorPoint = anchors[Bar.Position]
                    BarFrame.Size        = sizes[Bar.Position]
                    BarOutline.Size      = outl[Bar.Position]
                    BarOutline.Parent    = NewParent
                    Objects[BarName .. "Gradient"].Rotation = grads[Bar.Position][1]
                    Objects[BarName .. "Gradient"].Offset   = grads[Bar.Position][2]
                    Objects[BarName .. "Gradient"].Color = ColorSequence_new{ColorSequenceKeypoint_new(0, Bar.Color[1]), ColorSequenceKeypoint_new(0, Bar.Color[2]), ColorSequenceKeypoint_new(1, Bar.Color[3])}
                else
                    NewParent.Visible = false
                end

                local BT = Objects[BarName .. "Text"]
                if Bar.Text.Enabled and IsPlayer then
                    local val, vis = Bar.Text.Type(Target, CO)
                    BT.Text = tostring(math_floor(val)) .. Bar.Text.Ending
                    BT.TextColor3 = Bar.Text.Color
                    BT.TextTransparency = Bar.Text.Transparency
                    BT.UIStroke.Transparency = Bar.Text.Transparency
                    if Bar.Text.FollowBar then
                        BT.Visible = vis
                        BT.Parent = BarFrame
                        BT.ZIndex = 10
                        BT.TextXAlignment = Enum.TextXAlignment.Center
                    else
                        BT.Visible = true
                        BT.Parent = Objects[Bar.Text.Position .. "TextHolder"]
                        BT.TextXAlignment = TextAlignments[Bar.Text.Position]
                        BT.AnchorPoint = Vector2_new(0,0)
                    end
                else
                    BT.Visible = false
                end
            end

            -- ── Name ──
            local NameText = Objects["TargetName"]
            if Settings.Name.Enabled then
                local n = if Settings.Name.UseDisplay then (IsPlayer and Target.DisplayName or Target.Name) else Target.Name
                NameText.Visible = true
                NameText.Text = Utility.GetFontType(Settings, n)
                NameText.TextXAlignment = TextAlignments[Settings.Name.Position]
                NameText.Parent = Objects[Settings.Name.Position .. "TextHolder"]
                NameText.TextColor3 = Settings.Name.Color
                NameText.TextTransparency = Settings.Name.Transparency
                NameText.UIStroke.Transparency = Settings.Name.Transparency
            else
                NameText.Visible = false
            end

            -- ── Distance ──
            local DistText = Objects["Distance"]
            if Settings.Distance.Enabled then
                DistText.Visible = true
                DistText.TextXAlignment = TextAlignments[Settings.Distance.Position]
                DistText.Parent = Objects[Settings.Distance.Position .. "TextHolder"]
                DistText.TextColor3 = Settings.Distance.Color
                DistText.TextTransparency = Settings.Distance.Transparency
                DistText.UIStroke.Transparency = Settings.Distance.Transparency
                DistText.Text = Utility.GetFontType(Settings, tostring(math_floor(Distance)) .. Settings.Distance.Ending)
            else
                DistText.Visible = false
            end

            -- ── Weapon ──
            local WeaponText = Objects["Weapon"]
            if IsPlayer and Settings.Weapon.Enabled then
                local t = PlayerHelper.GetTool(Target) or TargetInfo.CurrentTool
                WeaponText.Visible = true
                WeaponText.TextXAlignment = TextAlignments[Settings.Weapon.Position]
                WeaponText.Parent = Objects[Settings.Weapon.Position .. "TextHolder"]
                WeaponText.TextColor3 = Settings.Weapon.Color
                WeaponText.TextTransparency = Settings.Weapon.Transparency
                WeaponText.UIStroke.Transparency = Settings.Weapon.Transparency
                WeaponText.Text = Utility.GetFontType(Settings, t)
            else
                WeaponText.Visible = false
            end

            -- ── Flags ──
            local FlagsText = Objects["Flags"]
            if Settings.Flags.Enabled then
                local flags = Settings.Flags.Type(Target, CO) or {}
                FlagsText.Visible = true
                FlagsText.TextXAlignment = TextAlignments[Settings.Flags.Position]
                FlagsText.Parent = Objects[Settings.Flags.Position .. "TextHolder"]
                FlagsText.TextColor3 = Settings.Flags.Color
                FlagsText.TextTransparency = Settings.Flags.Transparency
                FlagsText.UIStroke.Transparency = Settings.Flags.Transparency
                FlagsText.Text = table_concat(flags, "\n")
            else
                FlagsText.Visible = false
            end

            SetTargetFade(TargetInfo, true)
        end

        function TargetInfo.Remove()
            for _, O in Objects do O:Destroy() end
            if TargetInfo.ChamsHighlight then TargetInfo.ChamsHighlight:Destroy() end
            if TargetInfo.CharacterConnection then TargetInfo.CharacterConnection:Disconnect() end
            if ToolConnection.Added then ToolConnection.Added:Disconnect() end
            if ToolConnection.Removed then ToolConnection.Removed:Disconnect() end
            ESP.Targets[Type][Target] = nil
        end

        TargetInfo.Init()
        task_spawn(function() TargetInfo.Update() end)
    end

    function ESP.RemoveTarget(T, Type)
        for Ty, _ in ESP.Settings do
            for target, info in ESP.Targets[Ty] or {} do
                if target == T then info.Remove() end
            end
        end
    end

    function ESP.Init()
        for Ty, _ in ESPSettings do
            ESP.Targets[Ty] = ESP.Targets[Ty] or {}
        end
    end

    function ESP.Unload()
        for _, C in ConnectionsTable do C:Disconnect() end
        for _, O in ObjectsTable do O:Destroy() end
        getgenv().Fonts = nil
    end
end

do -- Connections
    ESP.Init()

    for _, Player in Players:GetPlayers() do
        ESP.AddTarget(Player, "Players")
    end

    Utility.AddConnection(Players.PlayerAdded, LPH_NO_VIRTUALIZE(function(Player)
        Player.CharacterAdded:Wait()
        ESP.AddTarget(Player, "Players")
    end))

    Utility.AddConnection(Players.PlayerRemoving, LPH_NO_VIRTUALIZE(function(Player)
        ESP.RemoveTarget(Player, "Players")
    end))

    Utility.AddConnection(RunService.PreRender, LPH_NO_VIRTUALIZE(function()
        for Type, _ in ESP.Settings do
            for _, t in ESP.Targets[Type] do
                t.Update()
            end
        end
    end))
end
